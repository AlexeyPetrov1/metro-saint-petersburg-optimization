</style>
<SCRIPT language="JavaScript">
	function toggleDetail()	{
		var elements = document.getElementsByClassName('detail-vagon-km');
		if(elements != null && elements.length > 0){
		    for(var i=0; i< elements.length; i++){
			if(elements[i].style.display == 'none'){
			    elements[i].style.display = '';
			}
			else
    			    elements[i].style.display = 'none';
		    }
		}
    	};

</script>



<SCRIPT language="JavaScript">
//переключение типа периода
function switchPeriodType( radioValue ){
	if(radioValue == 0 || radioValue == -1)
	{
	    document.getElementById('monthTab').style.display='block';
	}
	else document.getElementById('monthTab').style.display='none';    

	if(radioValue == 1)
	{
	    document.getElementById('randomnessTab').style.display='block';
	}
	else document.getElementById('randomnessTab').style.display='none';    

	if(radioValue == 2)
	{
	    document.getElementById('quarterTab').style.display='block';
	}
	else document.getElementById('quarterTab').style.display='none';    

	if(radioValue == 3)
	{
	    document.getElementById('yearTab').style.display='block';
	}
	else document.getElementById('yearTab').style.display='none';    

	if(radioValue == 4)
	{
	    document.getElementById('halfYearTab').style.display='block';
	}
	else document.getElementById('halfYearTab').style.display='none';    

}
function switchPrintType(clickOn){

	if( clickOn == 2 )
	{
	    if( document.getElementById('print').checked == true )
	    {
		document.getElementById('print').checked = false;
	    }
	    if( document.getElementById('word').checked == true )
	    {
		document.getElementById('word').checked = false;
	    }
	}    
	if( clickOn == 1 )
	{
	    if( document.getElementById('print').checked == true )
	    {
		document.getElementById('print').checked = false;
	    }
	    if( document.getElementById('excel').checked == true )
	    {
		document.getElementById('excel').checked = false;
	    }
	}    
	if( clickOn == 0 )
	{
	    if( document.getElementById('word').checked == true )
	    {
		document.getElementById('word').checked = false;
	    }
	    if( document.getElementById('excel').checked == true )
	    {
		document.getElementById('excel').checked = false;
	    }
	}    
}
function checkPeriod(formObj){
var ckeckIndex = -1;
    for( var i=0 ; i < formObj["periodType"].length; i++)
    {
	if(formObj.periodType[i].checked == true)
	{ checkIndex = i; break; }
    }
    if(checkIndex == -1)return false;
    
    //если выбран отчетный период месяц
    if(formObj.periodType[checkIndex].value == 0)
    {
	 //переменная используемая для проверки корректности ввода даты    
	var dateCur   		= new Date();
	
	if(formObj["month"].value-1 > dateCur.getMonth() && dateCur.getFullYear()==formObj["yearInMonthTab"].value)
	{
    	    alert("Данный месяц еще не наступил"); 
	    return false;
	}
    }
    //если выбран отчетный период произвольный
    if(formObj.periodType[checkIndex].value == 1)
    {
	var dateFrom = new Date(formObj.yf.options[formObj.yf.selectedIndex].value, formObj.mf.options[formObj.mf.selectedIndex].value-1, formObj.df.options[formObj.df.selectedIndex].value);
	var dateTo   = new Date(formObj.yt.options[formObj.yt.selectedIndex].value, formObj.mt.options[formObj.mt.selectedIndex].value-1,  formObj.dt.options[formObj.dt.selectedIndex].value); 

//        var dstr = formObj.yf.options[formObj.yf.selectedIndex].value+' '+formObj.mf.options[formObj.mf.selectedIndex].value+' '+formObj.df.options[formObj.df.selectedIndex].value;
//	var m =  moment(dstr,'YYYY MM DD').format('M');

//        if ( m !=formObj.mf.options[formObj.mf.selectedIndex].value)
	if(formObj.df.options[formObj.df.selectedIndex].value >28 )
        if (dateFrom.getMonth()!=formObj.mf.options[formObj.mf.selectedIndex].value-1)
	{
	    alert("Дата начала поиска введена неправильно");
	    return false;
	} 

	if (dateTo.getMonth()!=formObj.mt.options[formObj.mt.selectedIndex].value-1)
	{
	    alert("Дата окончания поиска введена неправильно");
	    return false;
        }
	if ((dateTo-dateFrom)<0)
	{
	    alert("Начало поиска больше чем окончание поиска");
	    return false;
	}

    }
    //если выбран отчетный период квартал
    //проверяем наступил ли и закончился ли данный квартал
    if(formObj.periodType[checkIndex].value == 2)
    {
	var quarter = parseInt(formObj["quarter"].value);
	//номер квартала (к примеру 1-ый) * на число месяцев в квартале - получим последний месяц в данном квартале (3-ий)
	//отнимаем 3, а не 2, т.к. в javascript отсчет месяцев с 0
	var beginQuarter = new Date( formObj.yearInQuarterTab.value, (quarter*3-3), 01 );
	var endQuarter   = new Date( formObj.yearInQuarterTab.value, (quarter*3-1), 01 ); 
	var dateCur   		= new Date();

	if((dateCur - beginQuarter) < 0 )
	{
	    alert("Выбранный квартал еще не наступил");
	    return false;
	}			
	if((dateCur - endQuarter) < 0 )
	{
	    alert("Выбранный квартал еще не закончился");
	    return false;
	}			
    }
    //если выбран отчетный период полугодие
    //проверяем наступил ли и закончился ли данное полугодие
    if(formObj.periodType[checkIndex].value == 4)
    {
	var halfYear = parseInt(formObj["halfYear"].value);
	var beginQuarter = new Date( formObj.yearInHalfYearTab.value, (halfYear*6-6), 01 );
	var endQuarter   = new Date( formObj.yearInHalfYearTab.value, (halfYear*6-1), 01 ); 
	var dateCur   		= new Date();

	if((dateCur - beginQuarter) < 0 )
	{
	    alert("Выбранное полугодие еще не наступило");
	    return false;
	}			
	if((dateCur - endQuarter) < 0 )
	{
	    alert("Выбранное полугодие еще не закончилось");
	    return false;
	}			
    }
    
    if( document.getElementById('print').checked == true )
    {
    	formObj.target = "_blank";
    }else	
	formObj.target = "_self";	
	
    return true; 
}

</script>
<head><title>Отчетная форма МО-I</title></head>
